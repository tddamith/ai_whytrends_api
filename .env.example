# Postgres connection (Neon or Supabase)
DATABASE_URL=postgres://user:pass@host:5432/whytrends
# Anthropic API key (set as a secret in GitHub Actions / hosting, never commit)
ANTHROPIC_API_KEY=
# Trends country (ISO code)
TRENDS_GEO=US
# Max new articles written per pipeline run
MAX_ARTICLES_PER_RUN=4
# auto = publish articles that pass the quality gate; review = everything goes to the review queue
PUBLISH_MODE=review
# Bearer token for /admin endpoints
ADMIN_TOKEN=change-me
# Optional: web site revalidation hook, called after an article is published
WEB_REVALIDATE_URL=
WEB_REVALIDATE_SECRET=
# Optional: Pexels API key for licensed header images
PEXELS_API_KEY=
PORT=8787
