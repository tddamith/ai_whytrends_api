{
  "name": "ai-whytrends-api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "WhyTrends pipeline and API: Google Trends -> sources -> Claude-written explainers -> review queue -> published articles.",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx watch src/api/server.ts",
    "start": "tsx src/api/server.ts",
    "pipeline": "tsx src/pipeline/run.ts",
    "migrate": "tsx src/db/migrate.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.13.0",
    "@hono/node-server": "^2.1.11",
    "@mozilla/readability": "^0.6.0",
    "fast-xml-parser": "^5.12.1",
    "hono": "^4.13.21",
    "linkedom": "^0.18.15",
    "postgres": "^4.1.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^5.1.1"
  }
}
